<Window x:Class="KoaZa.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="KoaZa Football Analytics" Height="780" Width="1250" MinHeight="650" MinWidth="980" WindowState="Maximized" WindowStartupLocation="CenterScreen" Background="#F4F7F5">
  <Window.Resources>
    <Style TargetType="{x:Type Button}">
      <Setter Property="Padding" Value="12,7"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="{x:Type ComboBox}">
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Padding" Value="7,5"/>
    </Style>
    <Style TargetType="{x:Type DataGrid}">
      <Setter Property="RowHeight" Value="36"/>
      <Setter Property="AlternationCount" Value="2"/>
      <Setter Property="AlternatingRowBackground" Value="#F6F9F7"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CanUserResizeRows" Value="False"/>
    </Style>
    <Style TargetType="{x:Type DataGridColumnHeader}">
      <Setter Property="Background" Value="#EAF1EC"/>
      <Setter Property="Foreground" Value="#163B2B"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="8,10"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="BorderBrush" Value="#DDE7E0"/>
    </Style>
  </Window.Resources>
  <Border CornerRadius="22" Margin="8" Padding="12" Background="#F4F7F5" BorderBrush="#DCE7E0" BorderThickness="1">
  <Grid Margin="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,16">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <TextBlock Text="Language / زبان" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <ComboBox x:Name="LanguageBox" Width="105" Margin="0,0,8,0" Padding="6" SelectionChanged="LanguageBox_SelectionChanged"><ComboBoxItem Content="فارسی" Tag="fa"/><ComboBoxItem Content="English" Tag="en"/></ComboBox>
        <Button Content="Refresh list / نوسازی" Click="Refresh_Click" Padding="12,7" Margin="0,0,8,0"/>
        <Button Content="Import fixtures / دریافت بازی‌ها" Click="OpenFixtures_Click" Padding="12,7" Margin="0,0,8,0" Background="#163B2B" Foreground="White" BorderThickness="0"/>
        <Button Content="Settings / تنظیمات" Click="OpenApiSettings_Click" Padding="12,7" Background="#16865B" Foreground="White" BorderThickness="0"/>
      </StackPanel>
      <StackPanel>
        <TextBlock Text="KoaZa Football Analytics" FontSize="27" FontWeight="Bold" Foreground="#163B2B"/>
        <TextBlock Text="Historical-data match analysis • تحلیل آماری بر اساس نتایج تاریخی" FontSize="13" Foreground="#5E6E65" Margin="0,4,0,0"/>
      </StackPanel>
    </DockPanel>
    <Border Grid.Row="1" Background="White" CornerRadius="14" Padding="12" Margin="0,0,0,14">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Date / روز:" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox x:Name="DateFilterBox" Width="220" Padding="6" Margin="0,0,18,0" SelectionChanged="Filters_Changed"/>
        <TextBlock Text="Competition / لیگ:" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox x:Name="LeagueFilterBox" Width="260" Padding="6" SelectionChanged="Filters_Changed"/>
        <TextBlock x:Name="FixtureCountText" VerticalAlignment="Center" Foreground="#5E6E65" Margin="18,0,0,0"/>
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel>
      <Grid Height="620">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition Width="1.45*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="12" Margin="0,0,12,0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="Upcoming fixtures / بازی‌های پیش رو" FontSize="17" FontWeight="Bold" Foreground="#163B2B" Margin="0,0,0,10"/>
          <DataGrid x:Name="FixturesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="FixturesGrid_SelectionChanged" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.RowStyle>
              <Style TargetType="{x:Type DataGridRow}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsLive}" Value="True">
                    <Setter Property="Background" Value="#FFFFE7C2"/>
                    <Setter Property="Foreground" Value="#8A3D00"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <DataGridTextColumn Header="Date / ساعت" Binding="{Binding KickoffDisplay}" Width="1.15*"/>
              <DataGridTextColumn Header="League / لیگ" Binding="{Binding League}" Width="1.1*"/>
              <DataGridTextColumn Header="Home / میزبان" Binding="{Binding HomeTeam}" Width="1.1*"/>
              <DataGridTextColumn Header="Score / نتیجه" Binding="{Binding ScoreDisplay}" Width="0.65*"/>
              <DataGridTextColumn Header="Away / میهمان" Binding="{Binding AwayTeam}" Width="1.1*"/>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock x:Name="FixtureStatusText" Grid.Row="2" TextWrapping="Wrap" Foreground="#79551D" Margin="0,10,0,0"/>
        </Grid>
      </Border>
      <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="16">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Match analysis / تحلیل مسابقه" FontSize="18" FontWeight="Bold" Foreground="#163B2B"/>
            <TextBlock x:Name="MatchTitleText" Text="Select a match from the list / یک مسابقه انتخاب کن" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,4" TextWrapping="Wrap"/>
            <TextBlock x:Name="ModelStatusText" Text="Probabilities will be calculated from saved historical results." TextWrapping="Wrap" Foreground="#5E6E65" Margin="0,0,0,12"/>
          </StackPanel>
          <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="HomeChartTeamText" Text="Home team / میزبان" FontWeight="SemiBold" Foreground="#16865B" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="VS" Margin="12,0" Foreground="#7A8980" VerticalAlignment="Center"/><TextBlock x:Name="AwayChartTeamText" Grid.Column="2" Text="Away team / میهمان" FontWeight="SemiBold" Foreground="#D17A36" TextAlignment="Right" TextWrapping="Wrap"/></Grid>
            <TextBlock x:Name="MarketHeadingText" Text="Market probabilities / احتمال بازارها" FontSize="15" FontWeight="Bold"/>
          </StackPanel>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="Market probabilities / احتمال بازارها" FontSize="14" FontWeight="Bold" Margin="0,0,0,6"/>
              <Border x:Name="MarketChartFrame" Background="White" CornerRadius="8" Padding="8" BorderBrush="#E3EAE5" BorderThickness="1">
                <StackPanel>
                  <TextBlock x:Name="MarketChartReasonText" Visibility="Collapsed" TextWrapping="Wrap" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,8"/>
                  <ItemsControl x:Name="MarketsList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border x:Name="MarketRowCard" Background="Transparent" CornerRadius="5" Padding="5" Margin="0,2,0,3" ToolTip="{Binding Reason}">
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="2.3*"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="MarketLabelText" Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" FontSize="12"/>
                            <ProgressBar x:Name="MarketProgress" Grid.Column="1" Value="{Binding Percent}" Maximum="100" Height="13" VerticalAlignment="Center" Foreground="{Binding BarBrush}" Background="#E5ECE7" BorderThickness="0"/>
                            <TextBlock x:Name="MarketPercentText" Grid.Column="2" Text="{Binding PercentLabel}" VerticalAlignment="Center" HorizontalAlignment="Right" TextAlignment="Right" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="11" Margin="5,0,0,0"/>
                          </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                          <DataTrigger Binding="{Binding HasData}" Value="False">
                            <Setter TargetName="MarketRowCard" Property="Background" Value="#DD772A"/>
                            <Setter TargetName="MarketLabelText" Property="Foreground" Value="White"/>
                            <Setter TargetName="MarketPercentText" Property="Foreground" Value="White"/>
                            <Setter TargetName="MarketProgress" Property="Foreground" Value="#F8C28D"/>
                            <Setter TargetName="MarketProgress" Property="Background" Value="#B85D1C"/>
                          </DataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <TextBlock Text="Additional markets use real historical corners, shots, cards, referee and VAR data when enough samples are available; missing values are never assumed to be zero." TextWrapping="Wrap" Foreground="#7A8980" FontSize="11" Margin="0,2,0,6"/>
              <Separator Margin="0,8"/>
              <TextBlock Text="Match statistics &amp; events / آمار و رویدادهای مسابقه" FontSize="14" FontWeight="Bold" Margin="0,4,0,6"/>
              <TextBlock x:Name="StatsText" Text="Select a match to load statistics, cards, fouls, corners and events." TextWrapping="Wrap" Foreground="#405449" FontSize="12"/>
            </StackPanel>
          </ScrollViewer>
          <TextBlock Grid.Row="3" x:Name="DisclaimerText" Text="Probabilities are estimates, not guarantees. / احتمال‌ها تخمینی هستند، نه تضمین نتیجه." TextWrapping="Wrap" Foreground="#7A8980" Margin="0,10,0,0"/>
        </Grid>
      </Border>
      </Grid>
      <Border Height="430" Background="White" CornerRadius="10" Padding="12" Margin="0,12,0,0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="0,0,0,6">
            <TextBlock Text="Football news / اخبار فوتبال" FontSize="17" FontWeight="Bold" Foreground="#163B2B" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="Refresh news / نوسازی اخبار" Click="RefreshNews_Click" Padding="10,5" Background="#16865B" Foreground="White" Margin="8,0,0,0"/>
          </DockPanel>
          <TextBlock x:Name="NewsStatusText" Grid.Row="1" Text="Loading latest football headlines / در حال دریافت آخرین اخبار فوتبال..." TextWrapping="Wrap" Foreground="#7A8980" FontSize="11" Margin="0,0,0,6"/>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="NewsList">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Width="390" Margin="0,0,12,8" Padding="10" Background="#F6F9F7" CornerRadius="8">
                    <StackPanel>
                      <Button Tag="{Binding Url}" Click="NewsItem_Click" HorizontalContentAlignment="Left" Padding="0" BorderThickness="0" Background="Transparent" Foreground="#16734D" FontWeight="SemiBold"><TextBlock Text="{Binding Title}" TextWrapping="Wrap" Foreground="#16734D" FontWeight="SemiBold"/></Button>
                      <TextBlock Text="{Binding Source}" TextWrapping="Wrap" Foreground="#16865B" FontSize="10" FontWeight="SemiBold" Margin="0,4,0,0"/>
                      <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Foreground="#6A766E" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
      </StackPanel>
    </ScrollViewer>
    <TextBlock Grid.Row="3" Text="KoaZa • Local SQLite • Historical Poisson baseline" Foreground="#7A8980" Margin="0,12,0,0" HorizontalAlignment="Right"/>
  </Grid>
  </Border>
</Window>