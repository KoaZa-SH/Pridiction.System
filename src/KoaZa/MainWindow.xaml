<Window x:Class="KoaZa.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="KoaZa Football Analytics" Height="780" Width="1250" MinHeight="650" MinWidth="980" WindowStartupLocation="CenterScreen" Background="#F4F7F5">
  <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,16">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <TextBlock Text="Language / زبان" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <ComboBox x:Name="LanguageBox" Width="105" Margin="0,0,8,0" Padding="6" SelectionChanged="LanguageBox_SelectionChanged"><ComboBoxItem Content="فارسی" Tag="fa"/><ComboBoxItem Content="English" Tag="en"/></ComboBox>
        <Button Content="Refresh list / نوسازی" Click="Refresh_Click" Padding="12,7" Margin="0,0,8,0"/>
        <Button Content="Import fixtures / دریافت بازی‌ها" Click="OpenFixtures_Click" Padding="12,7" Margin="0,0,8,0" Background="#163B2B" Foreground="White" BorderThickness="0"/>
        <Button Content="API Settings / تنظیمات API" Click="OpenApiSettings_Click" Padding="12,7" Background="#16865B" Foreground="White" BorderThickness="0"/>
      </StackPanel>
      <StackPanel>
        <TextBlock Text="KoaZa Football Analytics" FontSize="27" FontWeight="Bold" Foreground="#163B2B"/>
        <TextBlock Text="Historical-data match analysis • تحلیل آماری بر اساس نتایج تاریخی" FontSize="13" Foreground="#5E6E65" Margin="0,4,0,0"/>
      </StackPanel>
    </DockPanel>
    <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="12" Margin="0,0,0,14">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Date / روز:" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox x:Name="DateFilterBox" Width="220" Padding="6" Margin="0,0,18,0" SelectionChanged="Filters_Changed"/>
        <TextBlock Text="Competition / لیگ:" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox x:Name="LeagueFilterBox" Width="260" Padding="6" SelectionChanged="Filters_Changed"/>
        <TextBlock x:Name="FixtureCountText" VerticalAlignment="Center" Foreground="#5E6E65" Margin="18,0,0,0"/>
      </StackPanel>
    </Border>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.08*"/><ColumnDefinition Width="1.45*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="12" Margin="0,0,12,0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="Upcoming fixtures / بازی‌های پیش رو" FontSize="17" FontWeight="Bold" Foreground="#163B2B" Margin="0,0,0,10"/>
          <DataGrid x:Name="FixturesGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="FixturesGrid_SelectionChanged" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Date / ساعت" Binding="{Binding KickoffDisplay}" Width="1.15*"/>
              <DataGridTextColumn Header="League / لیگ" Binding="{Binding League}" Width="1.1*"/>
              <DataGridTextColumn Header="Home / میزبان" Binding="{Binding HomeTeam}" Width="1.2*"/>
              <DataGridTextColumn Header="Away / میهمان" Binding="{Binding AwayTeam}" Width="1.2*"/>
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock x:Name="FixtureStatusText" Grid.Row="2" TextWrapping="Wrap" Foreground="#79551D" Margin="0,10,0,0"/>
        </Grid>
      </Border>
      <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="16">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Match analysis / تحلیل مسابقه" FontSize="18" FontWeight="Bold" Foreground="#163B2B"/>
            <TextBlock x:Name="MatchTitleText" Text="Select a match from the list / یک مسابقه انتخاب کن" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,4" TextWrapping="Wrap"/>
            <TextBlock x:Name="ModelStatusText" Text="Probabilities will be calculated from saved historical results." TextWrapping="Wrap" Foreground="#5E6E65" Margin="0,0,0,12"/>
          </StackPanel>
          <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="HomeChartTeamText" Text="Home team / میزبان" FontWeight="SemiBold" Foreground="#16865B" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="VS" Margin="12,0" Foreground="#7A8980" VerticalAlignment="Center"/><TextBlock x:Name="AwayChartTeamText" Grid.Column="2" Text="Away team / میهمان" FontWeight="SemiBold" Foreground="#D17A36" TextAlignment="Right" TextWrapping="Wrap"/></Grid>
            <TextBlock x:Name="MarketHeadingText" Text="Market probabilities / احتمال بازارها" FontSize="15" FontWeight="Bold"/>
          </StackPanel>
          <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="MarketsList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,3,0,7">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="2.2*"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="62"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" FontSize="12"/>
                    <ProgressBar Grid.Column="1" Value="{Binding Percent}" Maximum="100" Height="13" VerticalAlignment="Center" Foreground="#16865B" Background="#E5ECE7" BorderThickness="0"/>
                    <TextBlock Grid.Column="2" Text="{Binding PercentLabel}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="12"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <TextBlock Grid.Row="3" x:Name="DisclaimerText" Text="Probabilities are estimates, not guarantees. / احتمال‌ها تخمینی هستند، نه تضمین نتیجه." TextWrapping="Wrap" Foreground="#7A8980" Margin="0,10,0,0"/>
        </Grid>
      </Border>
    </Grid>
    <TextBlock Grid.Row="3" Text="KoaZa • Local SQLite • Historical Poisson baseline" Foreground="#7A8980" Margin="0,12,0,0" HorizontalAlignment="Right"/>
  </Grid>
</Window>