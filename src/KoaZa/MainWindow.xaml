<Window x:Class="KoaZa.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="KoaZa Football Analytics — MVP" Height="700" Width="1000" MinHeight="600" MinWidth="850" WindowStartupLocation="CenterScreen" Background="#F4F7F5">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Margin="0,0,0,18">
      <Button Content="API Settings / تنظیمات API" Click="OpenApiSettings_Click" HorizontalAlignment="Right" Padding="14,7" Margin="0,0,0,8" Background="#16865B" Foreground="White" BorderThickness="0" />
      <TextBlock Text="KoaZa Football Analytics" FontSize="28" FontWeight="Bold" Foreground="#163B2B" />
      <TextBlock Text="MVP • Poisson model • Local SQLite database" FontSize="13" Foreground="#5E6E65" Margin="0,5,0,0" />
    </StackPanel>
    <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="16" Margin="0,0,0,14">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,12,0"><TextBlock Text="Home team" Margin="0,0,0,6"/><TextBox x:Name="HomeTeamBox" Text="Home Team" Padding="8" /></StackPanel>
        <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Away team" Margin="0,0,0,6"/><TextBox x:Name="AwayTeamBox" Text="Away Team" Padding="8" /></StackPanel>
        <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="Expected home goals" TextWrapping="Wrap" Height="34"/><TextBox x:Name="HomeRateBox" Text="1.45" Padding="8" /></StackPanel>
        <StackPanel Grid.Column="3" Margin="0,0,12,0"><TextBlock Text="Expected away goals" TextWrapping="Wrap" Height="34"/><TextBox x:Name="AwayRateBox" Text="1.10" Padding="8" /></StackPanel>
        <Button Grid.Column="4" Content="Analyze &amp; Save" Padding="16,10" VerticalAlignment="Bottom" Background="#16865B" Foreground="White" BorderThickness="0" Click="AnalyzeButton_Click" />
      </Grid>
    </Border>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.3*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="18" Margin="0,0,12,0">
        <StackPanel><TextBlock Text="Match probabilities" FontSize="18" FontWeight="Bold" Margin="0,0,0,14"/>
          <TextBlock x:Name="MatchTitle" Text="Home Team vs Away Team" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>
          <TextBlock x:Name="HomeWinText" Text="Home win: —" Margin="0,0,0,8" FontSize="15"/>
          <TextBlock x:Name="DrawText" Text="Draw: —" Margin="0,0,0,8" FontSize="15"/>
          <TextBlock x:Name="AwayWinText" Text="Away win: —" Margin="0,0,0,14" FontSize="15"/>
          <Separator Margin="0,0,0,14"/>
          <TextBlock x:Name="OverText" Text="Over 2.5 goals: —" Margin="0,0,0,8"/>
          <TextBlock x:Name="UnderText" Text="Under 2.5 goals: —" Margin="0,0,0,8"/>
          <TextBlock x:Name="BttsText" Text="Both teams to score: —" Margin="0,0,0,8"/>
          <TextBlock x:Name="QualityText" Text="Data quality: User-entered rates only" TextWrapping="Wrap" Foreground="#9A5A16" Margin="0,16,0,0"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="18">
        <StackPanel><TextBlock Text="Most likely exact scores" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
          <DataGrid x:Name="ScoresGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" Height="310">
            <DataGrid.Columns><DataGridTextColumn Header="Score" Binding="{Binding Score}" Width="*"/><DataGridTextColumn Header="Probability" Binding="{Binding Probability}" Width="*"/></DataGrid.Columns>
          </DataGrid>
          <TextBlock Text="Important: these are mathematical outputs from the rates entered above, not verified match forecasts." TextWrapping="Wrap" Foreground="#5E6E65" Margin="0,14,0,0"/>
        </StackPanel>
      </Border>
    </Grid>
    <TextBlock Grid.Row="3" Text="KoaZa • Local-first • No guaranteed outcomes" Foreground="#7A8980" Margin="0,14,0,0" HorizontalAlignment="Right" />
  </Grid>
</Window>
